{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/map", "destination": "/map.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/joinus", "destination": "/joinus.html" }
  ],
  "headers": [
    {
      "source": "/acidhelp-shareable.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "acid-help.vercel.app" }],
      "destination": "https://www.acidhelp.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "acid-help.vercel.app" }],
      "destination": "https://www.acidhelp.com/:path*",
      "permanent": true
    },
    { "source": "/map.html", "destination": "/map", "permanent": true },
    { "source": "/resources.html", "destination": "/resources", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/joinus.html", "destination": "/joinus", "permanent": true }
  ]
}
